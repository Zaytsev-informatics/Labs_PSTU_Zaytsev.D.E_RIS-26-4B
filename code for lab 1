Лабораторная работа №1 - задание 1
Вычисление выражения для типов float и double с промежуточными переменными.

#include <iostream>
#include <iomanip>
#include <cmath>
using namespace std;

// Шаблонная функция выполняет вычисления для float и double.
template <typename T>
void calculate(const char* type, T a, T b, int precision) {
    // Вычисляем степени и произведения отдельно.
    T term1 = pow(a - b, T(3));
    T term2 = pow(a, T(3));
    T term3 = T(3) * a * b * b;
    T term4 = pow(b, T(3));
    T term5 = T(3) * a * a * b;

    // Находим числитель, знаменатель и результат выражения.
    T numerator = term1 - (term2 - term3);
    T denominator = term4 - term5;
    T result = numerator / denominator;

    // Выводим тип данных и результаты промежуточных вычислений.
    cout << "\nТип: " << type << "\n"
         << setprecision(precision)
         << "(a-b)^3 = " << term1 << "\na^3 = " << term2
         << "\n3ab^2 = " << term3 << "\nb^3 = " << term4
         << "\n3a^2b = " << term5 << "\nЧислитель = " << numerator
         << "\nЗнаменатель = " << denominator
         << "\nРезультат = " << result << "\n";
}

int main() {
    // Значения a и b по условию варианта 6.
    const float af = 1000.0f, bf = 0.0001f;
    const double ad = 1000.0, bd = 0.0001;

    cout << "Вариант 6. Задание 1\n";
    calculate("float", af, bf, 10);
    calculate("double", ad, bd, 17);

    return 0;
}


Лабораторная работа №1 - задание 2
Вычисление выражений с префиксными операциями ++ и --.

#include <iostream>
using namespace std;

int main() {
    // Выводим название варианта и номер задания.
    cout << "Вариант 6. Задание 2\n";

    // Для каждого выражения задаём независимые начальные значения m = 5, n = 5.
    cout << "Начальные значения для каждого выражения: m = 5, n = 5\n\n";

    int m1 = 5, n1 = 5;

    // ++n сначала увеличивает n до 6, затем используется новое значение.
    // Вычисляем: 5 - 6 = -1.
    int r1 = m1 - ++n1;

    cout << "1) m - ++n = " << r1
         << "; после вычисления: m = " << m1
         << ", n = " << n1 << '\n';

    int m2 = 5, n2 = 5;

    // ++m даёт 6, --n даёт 4; сравнение 6 > 4 истинно.
    bool r2 = ++m2 > --n2;

    cout << "2) ++m > --n = " << boolalpha << r2
         << " (true - истина); после вычисления: m = " << m2
         << ", n = " << n2 << '\n';

    int m3 = 5, n3 = 5;

    // --n даёт 4, ++m даёт 6; сравнение 4 < 6 истинно.
    bool r3 = --n3 < ++m3;

    cout << "3) --n < ++m = " << boolalpha << r3
         << " (true - истина); после вычисления: m = " << m3
         << ", n = " << n3 << '\n';

    return 0;
}
